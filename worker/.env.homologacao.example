# Copie para um arquivo privado fora do Git e preencha somente no Worker QA.
# Esta marca ativa a fronteira que recusa banco/Storage/ambiente de produção.
APP_ENVIRONMENT="homologacao"

SISTEMA_FISCAL_URL="https://receita.pr.gov.br/login"
AMBIENTE_EMISSAO="teste"
HABILITAR_PRODUCAO_FISCAL="false"
MODO_OPERACAO="conferencia"

# O usuário precisa ser exatamente o papel exclusivo do QA, incluindo o ref.
# Não reutilize nf_worker_local, nf_worker_vm, postgres nem qualquer URL real.
WORKER_DATABASE_URL=""
WORKER_ID="worker-qa-local-01"
FONTE_TAREFAS="banco"
TESTAR_INTEGRACAO_BANCO="true"
PROCESSAR_FILA_BANCO="true"
WORKER_PERSISTENTE="true"
MAX_CONCORRENCIA="1"
HEADLESS="true"
INSPECIONAR="false"

# Só habilite depois de criar uma chave exclusiva do Storage QA.
ARMAZENAR_DOCUMENTOS="true"
SUPABASE_URL="https://szakgftippcqtuqwxsox.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="documentos-fiscais"
DOCUMENTOS_RETENCAO_DIAS="30"

# Habilita a emissão fiscal exclusivamente no portal de testes.
TESTAR_NAVEGACAO_EMISSAO="true"
TESTAR_PREENCHIMENTO_COMPLETO="true"
TESTAR_EMISSAO_HOMOLOGACAO="true"

# Permanecem desligados até o E2E principal passar.
LIMPAR_DOCUMENTOS_EXPIRADOS="false"
PROCESSAR_RECUPERACOES_DOCUMENTOS="false"
PROCESSAR_CANCELAMENTOS_FISCAIS="false"
WORKER_COORDENADO="false"
PAUSAR_ANTES_TRANSPORTE="false"
PAUSAR_ANTES_EMITIR="false"
PAUSAR_APOS_DOWNLOADS="false"
PAUSAR_APOS_CONSULTA="false"
