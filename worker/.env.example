# Copiar para .env e preencher assim que tiver os logins.

SISTEMA_FISCAL_URL="https://receita.pr.gov.br/login"
HEADLESS="false"          # false enquanto observamos o fluxo visualmente
MODO_OPERACAO="conferencia"  # simulacao | conferencia | automatico (seção 20 do doc. de visão)
DOWNLOAD_DIR="./downloads"
LOG_DIR="./logs"

# Integração Web -> Worker (não copiar DATABASE_URL do Web para produção).
# Use uma credencial exclusiva, com menor privilégio, para o Worker.
# WORKER_DATABASE_URL="postgresql://..."
# WORKER_ID="worker-local-01"
# FONTE_TAREFAS="arquivo" # arquivo | banco; banco continua em homologação
# TESTAR_INTEGRACAO_BANCO="false" # trava explícita do primeiro teste
# PROCESSAR_FILA_BANCO="false" # false só valida/devolve; true exige todas as travas de homologação

# Serviço persistente para VM/container. Só habilita quando fila, homologação,
# Storage, concorrência e modo headless estiverem todos configurados. Continua
# bloqueado para o ambiente fiscal normal/produção.
# WORKER_PERSISTENTE="false"
# WORKER_POLL_SECONDS="15"          # permitido: 5 a 300
# WORKER_ERROR_BACKOFF_SECONDS="30" # permitido: 5 a 600
# WORKER_HEALTH_TOUCH_SECONDS="30"  # permitido: 5 a 120
# WORKER_HEALTH_MAX_AGE_SECONDS="180"
# PAUSAR_ANTES_TRANSPORTE="false"    # obrigatório no serviço persistente

# Documentos fiscais — bucket privado já criado no Supabase. A chave deve ser
# secret/service-role e existir somente no servidor/Worker; prefira uma chave
# atual com prefixo sb_secret_. Nunca use NEXT_PUBLIC_ nem envie o valor ao Git
# ou ao chat.
# ARMAZENAR_DOCUMENTOS="false"
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SECRET_KEY=""
# SUPABASE_STORAGE_BUCKET="documentos-fiscais"
# DOCUMENTOS_RETENCAO_DIAS="30" # padrão: 30; permitido: 30 a 365

# Rotação do log ativo worker.log. Os históricos antigos são preservados.
# LOG_MAX_BYTES="5242880"  # 5 MiB
# LOG_BACKUP_COUNT="7"

# Recomendado pro PRIMEIRO teste ao vivo: rodar só 1 cliente, pra não abrir
# vários Inspectors ao mesmo tempo se mais de um travar junto.
CLIENTES_ATIVOS="CLIENTE_A"   # ou "CLIENTE_A,CLIENTE_B,CLIENTE_C" quando já estiver estável

# Quando true, abre o Playwright Inspector automaticamente no ponto exato
# onde qualquer etapa falhar — útil pra capturar seletores ao vivo em vez
# de reconstruir o cenário manualmente toda hora.
INSPECIONAR="true"

# Quando true, o smoke test também navega até a tela de emissão, mas não marca
# consentimento, não preenche nota e não emite nada.
TESTAR_NAVEGACAO_EMISSAO="false"

# Quando true, além de navegar até a emissão, preenche o formulário inteiro
# (consentimento, emitente, destinatário, identificação da operação,
# produtos, transporte) usando os dados de tarefa_real.json. NUNCA clica em
# "Emitir" — para nesse ponto de propósito. Exige TESTAR_NAVEGACAO_EMISSAO=true.
TESTAR_PREENCHIMENTO_COMPLETO="false"

# RESTRITO à homologação: quando true, após preencher tudo o Worker confere
# novamente o domínio de homologação, clica em Emitir e baixa XML/DANFE. O
# código bloqueia AMBIENTE_EMISSAO=normal. HEADLESS=true só é aceito no serviço
# persistente com as demais travas. Para A/B/C, defina MAX_CONCORRENCIA="3";
# o modo fiscal limita a três emissões paralelas.
TESTAR_EMISSAO_HOMOLOGACAO="false"

# Opcional. Limita quantos BrowserContexts (abas/sessões) ficam abertos ao
# mesmo tempo. Sem definir, não há limite (hoje equivale a len(CLIENTES_ATIVOS),
# já que só 3 foram testados em paralelo). Defina isso quando o worker
# crescer pra dezenas/centenas de tarefas por execução, pra não estourar
# CPU/RAM do servidor abrindo um Chromium com N abas simultâneas de uma vez.
# MAX_CONCORRENCIA="3"

# "teste" (padrão) usa o ambiente NFP-e TESTES/homologação da Receita PR —
# mesmo fluxo de telas, sem valor fiscal, RECOMENDADO durante desenvolvimento
# pra não poluir o histórico fiscal real com tentativas repetidas. Trocar
# pra "normal" só quando for testar contra o sistema fiscal de produção de
# propósito.
AMBIENTE_EMISSAO="teste"

# Um bloco por cliente — login é o CPF do EMITENTE (não do cliente/destinatário).
# NOME_EMITENTE não é segredo e serve para diferenciar os arquivos de cada
# emissor quando o mesmo mercado é atendido por empresas diferentes.
CLIENTE_A_NOME_EMITENTE=""
CLIENTE_B_NOME_EMITENTE=""
CLIENTE_C_NOME_EMITENTE=""
# Nunca commitar este arquivo preenchido.
CLIENTE_A_LOGIN=""
CLIENTE_A_SENHA=""
# Texto exibido após o login, por exemplo o nome do emitente. Não registrar
# CPF, senha ou qualquer dado sensível nos logs.
CLIENTE_A_IDENTIDADE_ESPERADA=""
# Valor da option do emitente na tela NFP-e. Só é necessário para
# TESTAR_PREENCHIMENTO_COMPLETO=true.
CLIENTE_A_EMITENTE=""

CLIENTE_B_LOGIN=""
CLIENTE_B_SENHA=""
CLIENTE_B_IDENTIDADE_ESPERADA=""
CLIENTE_B_EMITENTE=""

CLIENTE_C_LOGIN=""
CLIENTE_C_SENHA=""
CLIENTE_C_IDENTIDADE_ESPERADA=""
CLIENTE_C_EMITENTE=""
