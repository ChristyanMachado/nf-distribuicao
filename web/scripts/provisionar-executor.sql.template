-- Execute via psql como administrador, depois da migration 0016.
-- Valores: worker_role=nf_executor_pc1, worker_id=pc-principal,
-- worker_priority=10, worker_capacity=1. IDs e papéis distintos por computador.
-- Este arquivo nunca recebe senha. \password envia senha protegida ao servidor;
-- guarde-a no gerenciador e configure worker.env via canal privado.
\if :{?worker_role}
\else
  \echo 'Defina worker_role, worker_id, worker_priority e worker_capacity.'
  \quit
\endif
BEGIN;
CREATE ROLE :"worker_role" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 10;
GRANT CONNECT ON DATABASE :DBNAME TO :"worker_role";
GRANT USAGE ON SCHEMA fiscal TO :"worker_role";
GRANT USAGE ON TYPE fiscal.status_tarefa,fiscal.status_cancelamento_fiscal TO :"worker_role";
GRANT SELECT ON fiscal.workers,fiscal.worker_coordination,fiscal.tarefas,fiscal.notas,
 fiscal.cancelamentos_fiscais,fiscal.recuperacoes_documentos,fiscal.configuracoes_operacionais TO :"worker_role";
GRANT UPDATE (status,reservada_por,reserva_token,reserva_expira_em,tentativas,iniciado_em,
 atualizado_em,mensagem_status,ultimo_erro,codigo_erro,concluido_em) ON fiscal.tarefas TO :"worker_role";
GRANT INSERT (tarefa_id,cliente_id,numero,chave_acesso,protocolo_autorizacao,status,valor_total,data_emissao) ON fiscal.notas TO :"worker_role";
GRANT UPDATE (pdf_path,xml_path,documento_expira_em,limpeza_reserva_token,limpeza_reserva_expira_em,
 status,mensagem_erro) ON fiscal.notas TO :"worker_role";
GRANT UPDATE (status,tentativas,reservada_por,reserva_token,reserva_expira_em,mensagem_status,
 codigo_erro,iniciada_em,concluida_em,atualizado_em) ON fiscal.recuperacoes_documentos TO :"worker_role";
GRANT UPDATE (status,tentativas,reservada_por,reserva_token,reserva_expira_em,mensagem_status,
 codigo_erro,iniciada_em,concluida_em,atualizado_em,external_started_at) ON fiscal.cancelamentos_fiscais TO :"worker_role";
GRANT EXECUTE ON FUNCTION fiscal.reservar_tarefas_worker(text,integer,integer),
 fiscal.worker_start(text,uuid,text,integer),fiscal.worker_heartbeat(text,uuid,boolean,text),
 fiscal.worker_admission(text,uuid),fiscal.worker_summary(text,uuid),fiscal.worker_stop(text,uuid),
 fiscal.worker_recover_abandoned(text,uuid) TO :"worker_role";
INSERT INTO fiscal.workers(worker_id,db_role,priority,capacity_limit)
 VALUES (:'worker_id',:'worker_role',:worker_priority,:worker_capacity);
COMMIT;
\password :worker_role
-- Não ativa worker_coordination. Senha deve ser configurada antes da conexão.
-- No pooler: usuário <worker_role>.<project-ref>, conforme Connect do projeto.
-- Web dedicado, quando existir, recebe apenas SELECT fiscal.worker_status.
