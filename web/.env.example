# Copie para .env.local e preencha com os dados do projeto Supabase
# (o MESMO projeto já usado pelo sistema de ponto eletrônico — este
# sistema usa um schema Postgres separado, "fiscal", para não colidir).

# Connection string do Supabase (Settings > Database > Connection string > URI)
# Use a porta do connection pooler (6543) em produção/serverless.
DATABASE_URL="postgresql://postgres:[SENHA]@[PROJETO].supabase.co:5432/postgres"

# Preenchidos quando formos usar Auth/Storage nas próximas fases
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Hosts exatos autorizados para links assinados de PDF/XML, separados por
# vírgula e sem https:// (ex.: abcdef.supabase.co). Vazio bloqueia todo link.
NEXT_PUBLIC_STORAGE_HOSTS=""

# Sessão administrativa atual. Em produção é obrigatória e fail-closed.
# O segredo deve ter ao menos 32 caracteres aleatórios. Nunca reutilize senha fiscal.
APP_ADMIN_USER=""
APP_ADMIN_PASSWORD=""
APP_SESSION_SECRET=""
# Em desenvolvimento local, true também exige login.
APP_AUTH_ENABLED="false"
