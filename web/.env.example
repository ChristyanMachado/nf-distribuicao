# Copie para .env.local e preencha com os dados do projeto Supabase.
# No Vercel, cadastre os valores em Settings > Environment Variables; não
# envie este arquivo preenchido nem use variáveis de produção em Preview.
# (o MESMO projeto já usado pelo sistema de ponto eletrônico — este
# sistema usa um schema Postgres separado, "fiscal", para não colidir).

# Connection string do Supabase (Settings > Database > Connection string > URI)
# Use a porta do connection pooler (6543) em produção/serverless.
DATABASE_URL="postgresql://postgres:[SENHA]@[PROJETO].supabase.co:5432/postgres"

# Storage privado. SUPABASE_SECRET_KEY recebe preferencialmente uma chave atual
# sb_secret_ e é exclusivamente server-side; nunca use o prefixo NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL contém apenas a URL pública do projeto e também
# alimenta a lista segura de hosts.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="documentos-fiscais"
NEXT_PUBLIC_SUPABASE_URL=""
# Preferida para autenticação de usuários existentes no Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Compatibilidade temporária com projetos que ainda usam a anon JWT legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Compatibilidade temporária com instalações que ainda usam a chave legada;
# prefira SUPABASE_SECRET_KEY em configurações novas.
SUPABASE_SERVICE_ROLE_KEY=""
# Hosts exatos autorizados para links assinados de PDF/XML, separados por
# vírgula e sem https:// (ex.: abcdef.supabase.co). Vazio bloqueia todo link.
NEXT_PUBLIC_STORAGE_HOSTS=""

# Sessão administrativa atual. Em produção é obrigatória e fail-closed.
# O segredo deve ter ao menos 32 caracteres aleatórios. Nunca reutilize senha fiscal.
APP_ADMIN_USER=""
APP_ADMIN_PASSWORD=""
APP_SESSION_SECRET=""
# "administrativo" preserva APP_ADMIN_USER/PASSWORD; "supabase" autentica
# usuários existentes e só aceita perfis com papel gerente e ativo=true.
APP_AUTH_PROVIDER="administrativo"
# Em desenvolvimento local, true também exige login.
APP_AUTH_ENABLED="false"
# Em qualquer deploy Vercel, use APP_AUTH_ENABLED="true" e configure usuário,
# senha forte e APP_SESSION_SECRET aleatório com pelo menos 32 caracteres.
